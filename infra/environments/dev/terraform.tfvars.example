aws_region = "eu-central-1"

# S3 bucket names are globally unique. Replace the account fragment with your own
# stable identifier before creating terraform.tfvars.
bucket_name        = "threatflow-bronze-dev-123456789012"
silver_bucket_name = "threatflow-silver-dev-123456789012"

bronze_prefix                            = "bronze"
noncurrent_version_retention_days        = 90
silver_prefix                            = "silver"
silver_noncurrent_version_retention_days = 30

# S3 publishes matching EPSS Bronze object-created events to this Standard queue;
# Lambda consumes them through an enabled event-source mapping. Existing objects are
# not replayed when the notification is created.
epss_silver_queue_name                          = "threatflow-epss-bronze-events-dev"
epss_silver_dlq_name                            = "threatflow-epss-bronze-events-dev-dlq"
epss_silver_queue_visibility_timeout_seconds    = 1800
epss_silver_queue_message_retention_seconds     = 345600
epss_silver_dlq_message_retention_seconds       = 1209600
epss_silver_queue_max_receive_count             = 5

epss_silver_image_repository_name         = "threatflow/epss-silver"
epss_silver_image_untagged_retention_days = 7

# Use the immutable digest returned by ECR after building, pushing, and scanning
# the ARM64 image. A tag such as :latest is intentionally rejected.
epss_silver_lambda_image_uri            = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/threatflow/epss-silver@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
epss_silver_lambda_function_name        = "threatflow-epss-silver-dev"
epss_silver_lambda_execution_role_name  = "threatflow-epss-silver-dev-execution"
epss_silver_lambda_memory_size_mb       = 2048
epss_silver_lambda_timeout_seconds      = 300
epss_silver_lambda_reserved_concurrency = -1
epss_silver_lambda_log_retention_days   = 30
epss_silver_event_source_mapping_enabled     = true
epss_silver_event_source_maximum_concurrency = 2
# Exact-date DQ exceptions only after an investigated upstream anomaly.
epss_minimum_count_overrides = {}

cisa_silver_lambda_image_uri              = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/threatflow-cisa-silver-dev@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
cisa_silver_event_source_mapping_enabled  = false
cisa_minimum_record_count                 = 100
cisa_minimum_previous_ratio               = 0.8

nvd_silver_lambda_image_uri             = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/threatflow-nvd-silver-dev@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
nvd_silver_event_source_mapping_enabled = false

# Optional. After terraform apply, confirm the subscription from this mailbox.
silver_alert_email = ""

# Local Docker Compose only. This creates an IAM user with no access keys and attaches
# the Bronze object policy plus AWS SignInLocalDevelopmentAccess.
create_airflow_local_identity = false
airflow_local_user_name       = "threatflow-airflow-local"

# Separate Terraform-managed Glue Job. Keep the schedule disabled until the AUTO
# release has passed one manual smoke test. Terraform does not upload these artifacts.
create_gold_daily_runtime = false
gold_bucket_name          = "threatflow-gold-dev-123456789012"
gold_prefix               = "gold"
gold_catalog_database     = "threatflow_gold"
gold_glue_script_s3_uri    = "s3://threatflow-silver-dev-123456789012/_artifacts/glue/releases/<release>/vulnerability_priority_job.py"
gold_glue_wheel_s3_uri     = "s3://threatflow-silver-dev-123456789012/_artifacts/glue/releases/<release>/threatflow-0.1.0-py3-none-any.whl"
gold_max_input_lag_days    = 2
gold_schedule_expression   = "cron(0 9 * * ? *)"
gold_schedule_timezone     = "Europe/Berlin"
gold_schedule_enabled      = false
# Optional. After terraform apply, confirm the subscription from this mailbox.
gold_alert_email = ""

# Dedicated Athena serving boundary for the local Metabase instance. Terraform creates
# the service-account user but deliberately does not create or store its access key.
create_athena_metabase_serving                    = false
athena_results_bucket_name                        = "threatflow-athena-results-dev-123456789012"
athena_results_retention_days                     = 7
athena_metabase_workgroup_name                    = "threatflow-metabase-dev"
athena_metabase_bytes_scanned_cutoff_per_query    = 1000000000
athena_metabase_user_name                         = "threatflow-metabase-athena-dev"
