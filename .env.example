THREATFLOW_POSTGRES_HOST=localhost
THREATFLOW_POSTGRES_PORT=5432
THREATFLOW_POSTGRES_DB=threatflow
THREATFLOW_POSTGRES_USER=threatflow
THREATFLOW_POSTGRES_PASSWORD=replace-me
AIRFLOW_ADMIN_PASSWORD=replace-me
AIRFLOW_JWT_SECRET=replace-with-a-long-random-secret
THREATFLOW_AIRFLOW_URL=http://localhost:8080
THREATFLOW_NVD_API_KEY=
THREATFLOW_GITHUB_TOKEN=
THREATFLOW_NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
THREATFLOW_NVD_MODIFIED_LOOKBACK_HOURS=48
THREATFLOW_NVD_PAGE_SIZE=2000
THREATFLOW_EPSS_HISTORY_RETENTION_DAYS=30
THREATFLOW_AIRFLOW_METADATA_RETENTION_DAYS=90
THREATFLOW_AIRFLOW_XCOM_RETENTION_DAYS=30
THREATFLOW_HTTP_CONNECT_TIMEOUT=10
THREATFLOW_HTTP_READ_TIMEOUT=60
THREATFLOW_HTTP_RETRIES=3
THREATFLOW_RAW_STORAGE_BACKEND=local
THREATFLOW_RAW_DATA_DIR=data/raw
THREATFLOW_S3_REPLICATION_ENABLED=false
THREATFLOW_S3_BRONZE_BUCKET=
THREATFLOW_S3_BRONZE_PREFIX=bronze
THREATFLOW_AWS_REGION=eu-central-1
# Host paths used only with docker-compose.aws.yml. The login cache contains temporary
# credentials and must stay outside Git with owner-only permissions.
THREATFLOW_AWS_PROFILE=threatflow-airflow
THREATFLOW_AWS_CONFIG_FILE=
THREATFLOW_AWS_LOGIN_CACHE_DIR=
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase_user
METABASE_DB_PASSWORD=replace-me
THREATFLOW_ANALYTICS_USER=threatflow_analytics
THREATFLOW_ANALYTICS_PASSWORD=replace-me
MB_ENCRYPTION_SECRET_KEY=replace-with-a-base64-secret-at-least-16-characters
MB_SESSION_SECRET_KEY=replace-with-a-different-base64-secret-at-least-16-characters
